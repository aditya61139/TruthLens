{
  "manifest_version": 3,
  "name": "TruthLens — AI Fact Checker",
  "version": "1.0.0",
  "description": "Verify factual claims, headlines, and detect misinformation in real time backed by credible evidence.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TruthLens Fact Check"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
