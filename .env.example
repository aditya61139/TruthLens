# ==============================================================================
# TruthLens API Key Configuration
# ==============================================================================
# You can provide a single GOOGLE_API_KEY (from Google AI Studio) which enables:
# 1. Gemini AI Analysis & Fact Synthesis
# 2. Live Google Search Grounding for real-time web verification
# 3. Google Fact Check Tools API queries
# Get a free key at: https://aistudio.google.com/app/apikey
# ==============================================================================

# Universal Google API Key (Recommended)
GOOGLE_API_KEY=

# Specific Google API Keys & Model (Optional overrides)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview
GOOGLE_FACTCHECK_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Third-Party News API (Optional)
NEWS_API_KEY=

# Local Cache & Database Configuration
DATABASE_URL=sqlite:///truthlens.db
CACHE_TTL_HOURS=72
FUZZY_MATCH_THRESHOLD=85.0
